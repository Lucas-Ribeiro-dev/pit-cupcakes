# Exemplo de variaveis de ambiente para o projeto PIT Cupcakes
# Observacao: O Spring Boot le variaveis de ambiente do sistema ou propriedades do Maven/JVM.
# O arquivo .env nao e carregado automaticamente pelo framework.
# Use entrada protegida no terminal para configurar senhas reais.

# Perfil do Spring Boot (ex: local ou local,demo)
SPRING_PROFILES_ACTIVE=local

# Banco de dados PostgreSQL principal (desenvolvimento/local)
DB_URL=jdbc:postgresql://localhost:5432/cupcakes
DB_USERNAME=usuario_local_ficticio
DB_PASSWORD=senha_ficticia_substitua_localmente

# Porta do servidor HTTP
PORT=8080

# Banco separado obrigatorio para executar a integracao PostgreSQL
DB_TEST_URL=jdbc:postgresql://localhost:5432/cupcakes_test
DB_TEST_USERNAME=usuario_teste_ficticio
DB_TEST_PASSWORD=senha_teste_ficticia_substitua_localmente

